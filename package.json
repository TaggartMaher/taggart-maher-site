{
  "name": "taggart-maher-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vite",
    "build:assets": "cargo run --quiet --release --manifest-path scripts/bake-textures/Cargo.toml -- static && cargo run --quiet --release --manifest-path scripts/bake-textures/Cargo.toml -- coffee-steam",
    "build": "svelte-check --tsconfig ./tsconfig.app.json && tsc -b tsconfig.node.json && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -b tsconfig.node.json",
    "deploy": "tsx scripts/deploy.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write . && eslint . --fix"
  },
  "dependencies": {
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "svelte": "^5.56.4",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/hast": "^3.0.4",
    "@types/node": "^25.6.0",
    "eslint": "^9.18.0",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^3.2.4"
  }
}
