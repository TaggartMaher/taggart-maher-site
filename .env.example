# Path to the Blender render output. Each pass lives in a subdirectory:
#   $BLENDER_RENDERS_DIR/beauty/beauty-####.exr
#   $BLENDER_RENDERS_DIR/cells/screen_K_####.exr
#   $BLENDER_RENDERS_DIR/cells/cells_manifest.json
#
# When unset, the asset build is skipped and the site runs in fallback mode
# (plain portfolio without the CGI scene).
BLENDER_RENDERS_DIR=/home/tag/cgi/projects/portfolio-site-overlay/renders

# Side length of the N×N screen-cell grid. Read by the Rust bake binary,
# the Vite client (via the CELLS_ envPrefix), and the Blender script.
CELLS_PER_SIDE=12

# Render-region crop applied to the CoffeeSteam view layer at render time
# and consumed by the Rust bake binary and the runtime composite shader to
# place the strip back into full-frame coords. Values are normalized
# fractions of the full beauty frame (width/height).
STEAM_CROP_MIN_X=0.69
STEAM_CROP_MAX_X=0.90
STEAM_CROP_MIN_Y=0.0
STEAM_CROP_MAX_Y=0.65

# Multiplier applied to the .blend's render_x / render_y at steam
# render time. The crop and the runtime strip rect are normalized, so
# this only sharpens the steam pass; overlay placement and scale are
# unchanged. Atlas bytes grow with the square of this value.
STEAM_RESOLUTION_MULTIPLIER=1.25

# Side length of the N×N cell grid baked into the steam emitter. Read by
# the Blender script (cell-object generation) and the Rust bake binary
# (manifest sanity check). Higher = finer per-pixel position recovery in
# the steam strip, at the cost of N² render time.
STEAM_CELLS_PER_SIDE=12

# Frame-grid layout used when packing the per-frame steam EXRs into the
# atlas PNG. The bake writes these into steam_atlas_meta.json so the
# runtime shader can sample the correct sub-rect for the current frame.
#
# Constraint: COLUMNS × ROWS must be ≥ the number of rendered steam
# frames (see FRAME_END in blender/render_steam.sh, currently 24). Pick
# factors close to square so neither axis overshoots a low-end GPU's
# max texture dimension (8192 is the typical floor) once multiplied by
# the per-frame pixel size — e.g. 6×4 of 720×1080 frames is 4320×4320,
# well under the limit. For 24 frames, 6×4 is the most square option.
STEAM_ATLAS_COLUMNS=6
STEAM_ATLAS_ROWS=4